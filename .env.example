# Token shared by Open WebUI and the studio (Kubernetes secret "studio", key "token").
# Reuse the one from modules 1 and 2, or generate one: openssl rand -hex 24
STUDIO_TOKEN=
# Redis password (Kubernetes secret "studio", key "redis"), reused from module 2.
REDIS_PASSWORD=
# Password of the Grafana administrator (secret "grafana-admin"). Generate one: openssl rand -hex 18
# The dashboard can be read without an account (anonymous read access); this account is for administration.
GRAFANA_ADMIN=
