# Jeton partagé entre Open WebUI et le studio (secret Kubernetes « studio », clé « jeton »).
# Reprenez celui des modules 1 et 2, ou générez-en un : openssl rand -hex 24
STUDIO_JETON=
# Mot de passe de Redis (secret Kubernetes « studio », clé « redis »), repris du module 2.
REDIS_MOT_DE_PASSE=
# Mot de passe de l'administrateur de Grafana (secret « grafana-admin »). Générez-en un : openssl rand -hex 18
# Le tableau de bord se lit sans compte (accès anonyme en lecture) ; ce compte sert à l'administration.
GRAFANA_ADMIN=
